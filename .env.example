# ============================================================
# arkefit-atendimento — variáveis de ambiente
# O scripts/instalar.sh cria o ".env" a partir deste arquivo, preenchendo domínios e senhas.
# Só LETSENCRYPT_EMAIL e o bloco SMTP ficam para você preencher.
# NUNCA faça commit do arquivo ".env" (ele já está no .gitignore).
# ============================================================

# --- Domínio (sslip.io) ---
# Depois de provisionar o VPS, pegue o IP dele e monte os domínios abaixo
# trocando os pontos por hífen. Ex.: IP 203.0.113.10 vira 203-0-113-10.sslip.io
CHATWOOT_DOMAIN=chatwoot.SEU-IP-AQUI.sslip.io
EVOLUTION_DOMAIN=evolution.SEU-IP-AQUI.sslip.io

# E-mail usado pelo Let's Encrypt para avisos sobre o certificado HTTPS
LETSENCRYPT_EMAIL=seu-email@exemplo.com

# --- Banco de dados (Postgres) ---
# Gere uma senha forte, ex.: openssl rand -hex 24
POSTGRES_USER=arkefit
POSTGRES_PASSWORD=GERE_UMA_SENHA_FORTE_AQUI

# --- Redis ---
# Gere uma senha forte, ex.: openssl rand -hex 24
REDIS_PASSWORD=GERE_UMA_SENHA_FORTE_AQUI

# --- Chatwoot ---
# Gere com: openssl rand -hex 64
CHATWOOT_SECRET_KEY_BASE=GERE_COM_OPENSSL_RAND_HEX_64

# --- Evolution API ---
# Chave que você mesmo cria para autenticar suas próprias chamadas à API.
# Gere com: openssl rand -hex 32
EVOLUTION_API_KEY=GERE_COM_OPENSSL_RAND_HEX_32

# --- SMTP (envio de e-mail do Chatwoot: convite de agente, redefinição de senha) ---
# Pode ser uma conta Gmail dedicada com "senha de app", ou outro provedor.
MAILER_SENDER_EMAIL=atendimento@seudominio.ou.gmail.com
SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=atendimento@seudominio.ou.gmail.com
SMTP_PASSWORD=SENHA_DE_APP_AQUI
