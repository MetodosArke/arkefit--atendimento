# ============================================================
# arkefit-atendimento — variáveis de ambiente
# O scripts/instalar.sh cria o ".env" a partir deste arquivo e preenche domínios e senhas.
# Só o bloco SMTP é seu, e é opcional.
# NUNCA faça commit do arquivo ".env" (ele já está no .gitignore).
# ============================================================

# --- Domínio (sslip.io, preenchido pelo instalador a partir do IP do servidor) ---
# IP 203.0.113.10 vira chatwoot.203-0-113-10.sslip.io
CHATWOOT_DOMAIN=chatwoot.SEU-IP-AQUI.sslip.io

# --- Senhas internas (geradas pelo instalador) ---
POSTGRES_USER=arkefit
POSTGRES_PASSWORD=gerado-pelo-instalador
REDIS_PASSWORD=gerado-pelo-instalador
CHATWOOT_SECRET_KEY_BASE=gerado-pelo-instalador

# --- SMTP (opcional): e-mail do Chatwoot — convite de agente, redefinição de senha ---
# Vazio, o Chatwoot funciona e só não envia e-mail. Com Gmail: conta dedicada com verificação
# em duas etapas e uma "senha de app" (myaccount.google.com/apppasswords). Exemplo:
#   MAILER_SENDER_EMAIL=suporte.arkefit@gmail.com
#   SMTP_ADDRESS=smtp.gmail.com
#   SMTP_USERNAME=suporte.arkefit@gmail.com
#   SMTP_PASSWORD=<senha de app>
MAILER_SENDER_EMAIL=
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
